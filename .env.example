# Copy to .env and fill in. Never commit the filled-in file.
#
# Two rules for values in this file, both of them Docker Compose's doing:
#   - Do not quote them. Compose strips the quotes here but not everywhere, so
#     a quoted value can reach the container with the quotes still attached.
#   - A literal `$` must be written `$$`. Compose expands `$NAME` inside these
#     values, silently replacing anything that looks like a variable with an
#     empty string. This is why the admin password hash is colon-separated.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
# IANA timezone name, e.g. Europe/Moscow, Asia/Yerevan, America/New_York.
# Decides where the day boundary falls for the "today" counters on the dashboard.
# All three processes must agree, so set it once here.
TZ=UTC
API_PORT=3000

# ---- Database ----
# Matches the credentials in docker/docker-compose.yml
DATABASE_URL=postgresql://autoposting:autoposting@localhost:5432/autoposting?schema=public

# ---- Admin panel (single user) ----
# scrypt hash of your password. Generate it with:
#   pnpm --filter @workspace/api hash-password
# It reads the password from stdin, so it stays out of your shell history.
ADMIN_PASSWORD_HASH=
# Random 32+ byte string used to sign the session cookie. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---- Telegram ----
# Create a bot with @BotFather, then make it an administrator of your channel.
TELEGRAM_BOT_TOKEN=
# Default chat that receives drafts for approval. The bot must be a member of it.
# Per-channel overrides live in the database.
TELEGRAM_MODERATION_CHAT_ID=

# ---- OpenRouter ----
OPENROUTER_API_KEY=
# Sent as HTTP-Referer / X-Title, shows up in your OpenRouter activity log.
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=AI Telegram Autoposting
